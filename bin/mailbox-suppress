#!/usr/bin/env bash
#
# mailbox-suppress — bounce-suppress a mailbox by address (ABUSE.md Tier 1).
#
# Dev tooling for the client DOM tier (the pipeline suppresses on a real
# 5.1.1/5.2.1 bounce; tests need the state on demand) and an operator lever
# for a known-dead destination. Runs the same pipeline function deliverd
# uses, in a one-off container (bin/server-run), so the in-app notification
# fires too.
#
# Usage: bin/mailbox-suppress <mailbox-email> [5.1.1|5.2.1]

set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: bin/mailbox-suppress <mailbox-email> [5.1.1|5.2.1]" >&2
  exit 2
fi

cd "$(dirname "$0")/.."
exec bin/server-run bun run src/scripts/mailboxSuppress.ts "$@"
