#!/usr/bin/env bash
# Default: disposable PostgreSQL container, removed after validation.
# --into accepts only an empty existing database; never overwrites live state.
set -euo pipefail
umask 077
[[ $# == 1 || ( $# == 3 && $2 == --into ) ]] || { echo 'usage: db-restore file.dump.age [--into DATABASE_URL]' >&2; exit 2; }
: "${BACKUP_AGE_IDENTITY:?Set the path to the off-host age private key}"
backup_file=$1
restore_tmp=$(mktemp -d)
restore_container=""
cleanup() {
  if [[ -n "$restore_container" ]]; then docker rm -f "$restore_container" >/dev/null; fi
  rm -rf "$restore_tmp"
}
trap cleanup EXIT
age --decrypt -i "$BACKUP_AGE_IDENTITY" "$backup_file" >"$restore_tmp/restore.dump"
if [[ $# == 3 ]]; then
  restore_url=$3
  restore_tables=$(psql "$restore_url" -XAt -v ON_ERROR_STOP=1 -c "SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname NOT IN ('pg_catalog','information_schema') AND n.nspname NOT LIKE 'pg_toast%' AND c.relkind IN ('r','p','v','m','S','f')")
  [[ "$restore_tables" == 0 ]] || { echo 'refusing restore: destination is not empty' >&2; exit 1; }
  pg_restore --dbname="$restore_url" --exit-on-error --single-transaction --no-owner --no-acl "$restore_tmp/restore.dump"
  psql "$restore_url" -X -v ON_ERROR_STOP=1 -c "SELECT status, count(*), sum(octet_length(raw)) AS queued_bytes FROM outbound_messages GROUP BY status; SELECT count(*) AS accounts FROM users; SELECT count(*) AS routes FROM aliases;"
else
  restore_container="virtu-restore-$(date +%s)-${RANDOM}"
  docker run -d --name "$restore_container" --network none -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_DB=virtu "${BACKUP_POSTGRES_IMAGE:-postgres:17-alpine}" >/dev/null
  ready=false
  for ((i=0; i<60; i++)); do
    if docker exec "$restore_container" pg_isready -U postgres -d virtu >/dev/null 2>&1; then ready=true; break; fi
    sleep 1
  done
  "$ready" || { echo 'scratch postgres did not become ready' >&2; exit 1; }
  docker exec -i "$restore_container" pg_restore -U postgres -d virtu --exit-on-error --single-transaction --no-owner --no-acl <"$restore_tmp/restore.dump"
  docker exec "$restore_container" psql -U postgres -d virtu -v ON_ERROR_STOP=1 -c "SELECT status, count(*), sum(octet_length(raw)) AS queued_bytes FROM outbound_messages GROUP BY status; SELECT count(*) AS accounts FROM users; SELECT count(*) AS routes FROM aliases;"
fi
echo 'restore validated; no mail workers were started'
