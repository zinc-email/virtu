#!/usr/bin/env bash
#
# user-create — run a local dev user through the passwordless login flow.
#
# One flow for signup and login: POST /auth/login emails a 6-digit code
# (queued; no deliverd runs in dev), bin/login-code pulls it off the queue,
# POST /auth/verify graduates/logs-in and mints the API key. Idempotent —
# rerunning just logs the user in again. Prints the API key. Requires the
# dev stack (`just up` + `just db push`).
#
# Usage: bin/user-create [email]
# Default: wes@qmail.com (the story-world persona, dev only)

set -euo pipefail

cd "$(dirname "$0")/.."

EMAIL="${1:-wes@qmail.com}"
BASE="http://localhost:${API_PORT:-3000}/api"

REQ=$(curl -s -X POST "$BASE/auth/login" -H 'content-type: application/json' \
  -d "{\"email\":\"$EMAIL\",\"device\":\"user-create\"}")
if [[ "$REQ" != *'"msg"'* ]]; then
  echo "login-code request failed for $EMAIL: $REQ" >&2
  exit 1
fi

CODE=$(bin/login-code "$EMAIL")
RES=$(curl -s -X POST "$BASE/auth/verify" -H 'content-type: application/json' \
  -d "{\"email\":\"$EMAIL\",\"code\":\"$CODE\",\"device\":\"user-create\"}")

if [[ "$RES" == *'"api_key"'* ]]; then
  KEY=$(printf '%s' "$RES" | sed -nE 's/.*"api_key":"([^"]+)".*/\1/p')
  echo "user:    $EMAIL"
  echo "api key: $KEY"
  echo
  echo "Log in at http://localhost:${CLIENT_PORT:-9000} (email + emailed code), or:"
  echo "  curl -H 'Authentication: $KEY' $BASE/user_info"
else
  echo "verify failed for $EMAIL: $RES" >&2
  exit 1
fi
