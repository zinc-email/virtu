#!/usr/bin/env bash
#
# notification-create — insert one in-app notification for a user.
#
# Dev tooling for the client DOM tier (notifications are produced by the mail
# pipeline; tests need one on demand) and an operator lever for announcements.
# Direct DB via the server's drizzle in a one-off container (bin/server-run).
#
# Usage: bin/notification-create <email> <title> <message>

set -euo pipefail

if [ $# -lt 3 ]; then
  echo "usage: bin/notification-create <email> <title> <message>" >&2
  exit 2
fi

cd "$(dirname "$0")/.."
exec bin/server-run bun run src/scripts/notificationCreate.ts "$1" "$2" "$3"
