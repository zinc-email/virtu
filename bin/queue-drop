#!/usr/bin/env bash
#
# queue-drop — drop queue rows (pending/sending -> failed "dropped by
# operator"). Same primitive as the admin API's drop, so the two surfaces
# can't diverge. Break-glass: direct DB, works with the API down.
#
# Usage: bin/queue-drop <id...>

set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: bin/queue-drop <id...>" >&2
  exit 2
fi

cd "$(dirname "$0")/.."
exec bin/server-run bun run src/scripts/queueDrop.ts "$@"
