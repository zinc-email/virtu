# Universal deploy Caddyfile — ONE file for every environment, differing only
# by env vars (like madi's). Serves the built static assets and terminates TLS:
#
#   /        -> www/dist   (static marketing homepage)
#   /app/*   -> client/dist (SPA; /app stripped so on-disk /static/* resolves)
#   /api/*   -> api:3000    (Fastify, verbatim — it owns the /api prefix)
#
# The path topology matches the dev proxy (Caddyfile.dev); the difference is
# this file serves built files rather than proxying the dev servers. Point a
# box at its own host with VIRTU_HOST:
#
#   VIRTU_HOST=zinc.email   docker compose -f docker-compose.serve.yml up   # prod
#   VIRTU_HOST=lmnop.email  docker compose -f docker-compose.serve.yml up   # staging
#
# TLS is env-driven too (default: Caddy's internal self-signed CA). For a
# public box set VIRTU_TLS_MODE to an ACME account email (that IS Caddy's
# "use ACME" spelling — `tls you@example.com`; `tls acme` is not a thing) or,
# behind a DNS-challenge provider, VIRTU_TLS_CHALLENGE / VIRTU_TLS_RESOLVERS.

{
	admin off
}

(site) {
	encode gzip zstd

	# API — verbatim; Fastify owns the /api prefix and its own auth boundary.
	handle /api/* {
		reverse_proxy api:3000
	}

	# SPA under /app. Strip /app so the on-disk paths (assets live at
	# client/dist/static/*, referenced as /app/static/* via assetPrefix)
	# resolve, and fall back to index.html for client-side deep links.
	redir /app /app/ 308
	handle_path /app/* {
		root * /srv/client
		try_files {path} /index.html
		file_server
	}

	# Everything else — the static homepage (Astro "directory" output, so a
	# clean URL like /how maps to /how/index.html).
	handle {
		root * /srv/www
		try_files {path} {path}/index.html {path}/ /404.html
		file_server
	}

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Everything is served self-hosted from this one origin (no CDNs — see
		# PLAN/CLAUDE.md), so a strict policy holds: no inline/eval scripts
		# (blunts XSS token exfil), API calls only same-origin. 'unsafe-inline'
		# is allowed for styles only (Astro scoped <style>, React style props);
		# style injection is not a meaningful exfiltration vector.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; form-action 'self'"
		-Server
	}
}

# Local prod-like preview (built assets, self-signed cert).
https://localhost {
	import site
	tls internal
}

# Deploy target — zinc.email (prod) / lmnop.email (staging), one per box.
https://{$VIRTU_HOST:dummy.localhost} {
	import site
	# HSTS only on the real public host (never the self-signed localhost
	# preview): force HTTPS for a year, close the first-visit downgrade window.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	tls {$VIRTU_TLS_MODE:internal} {
		{$VIRTU_TLS_CHALLENGE:}
		{$VIRTU_TLS_RESOLVERS:}
	}
}

# Satellite hostnames, both just redirects to the apex. mail.{host} exists so
# Caddy obtains + renews the MX cert, which the SMTP listeners reuse (the
# mail-certs one-shot copies it into the mail_certs volume — see
# docker-compose.serve.yml); www.{host} so the zone's www record serves.
https://mail.{$VIRTU_HOST:dummy.localhost}, https://www.{$VIRTU_HOST:dummy.localhost} {
	redir https://{$VIRTU_HOST:dummy.localhost}{uri} 308
	tls {$VIRTU_TLS_MODE:internal} {
		{$VIRTU_TLS_CHALLENGE:}
		{$VIRTU_TLS_RESOLVERS:}
	}
}
