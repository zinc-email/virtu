# virtu-ts server config. Copy to `server/.env` (gitignored) and edit.
# Bun auto-loads .env from the working directory; every entrypoint (api, mx,
# submission, deliverd) reads these via src/config.ts. Every var has a dev
# default — an empty .env runs locally. Values below are the defaults unless
# noted; the ones marked (PROD) MUST be overridden for production.

# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://virtu:virtu@localhost:5432/virtu
API_HOST=0.0.0.0
API_PORT=3000
# Requests/minute per IP across the auth routes (register/activate/login).
# The dev compose raises this to 1000 so the DOM test tier can register
# freely; keep the default in production.
AUTH_RATE_LIMIT_MAX=10

# ── Mail path (mx / submission / deliverd) ───────────────────────────────────
# Domain that aliases, reverse aliases, and VERP bounce addresses live on.
MAIL_DOMAIN=virtu.email
# Our MX hostname: SMTP banner, EHLO, Authentication-Results stamps.
MAIL_HOSTNAME=mail.virtu.email
# DKIM selector for our signing key in the dkim_keys table
# ({selector}._domainkey.{domain}).
DKIM_SELECTOR=mail
# (PROD) HMAC secret for VERP bounce addresses. >= 32 chars. The default is a
# known dev value — generate a real one: `openssl rand -base64 32`.
VERP_SECRET=insecure-dev-verp-secret-change-me-00
# (PROD) PEM cert + key for STARTTLS (25/587) and implicit TLS (465). Both
# unset => plaintext-only listeners (local dev), and AUTH-over-TLS is not
# required. Production needs a real cert for MAIL_HOSTNAME — in the serve
# stack that's Caddy's cert, synced into the mail_certs volume (README
# "Deploy" > "Mail TLS"), so a deploy box uses exactly these paths:
# SMTP_TLS_CERT_FILE=/mail-certs/fullchain.pem
# SMTP_TLS_KEY_FILE=/mail-certs/privkey.pem
SMTP_HOST=0.0.0.0
MX_PORT=25
SUBMISSION_PORT=587
SUBMISSION_TLS_PORT=465
# Max accepted message size, bytes (default 25 MiB).
SMTP_MAX_MESSAGE_SIZE=26214400

# ── Delivery queue (deliverd) ────────────────────────────────────────────────
QUEUE_POLL_MS=1000
QUEUE_BATCH_SIZE=10
# Max delivery attempts before a transient failure becomes permanent.
QUEUE_MAX_TRIES=6

# ── Billing (Stripe — optional) ──────────────────────────────────────────────
# All four unset => billing routes answer 503, rest of the app is unaffected.
# Use test-mode keys for local dev. See README "Billing".
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen`
# STRIPE_PRICE_ID=price_...                # a recurring price
# BILLING_RETURN_URL=http://localhost:9000 # browser return origin
