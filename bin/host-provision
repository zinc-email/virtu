#!/usr/bin/env bash
# host-provision — one-time (idempotent) setup of a fresh Debian box for the
# serve stack: swap (the nanodes have 1GB RAM and the frontend build needs
# more), Docker CE + compose plugin, git, bun + just (the break-glass CLI runs
# on the host, not in a container), unattended security upgrades.
#
# Run from a workstation:   ssh root@<box> 'bash -s' < bin/host-provision
# Or on the box itself:     bash bin/host-provision
#
# Per-box things this does NOT do (see README "Deploy"): rDNS, DNS records,
# cloning the repo, writing server/.env, starting the stack.
set -euo pipefail

if [[ $(id -u) -ne 0 ]]; then
  echo "host-provision: must run as root" >&2
  exit 1
fi

# ── Swap: 2G file, so docker + postgres + the one-shot frontend build fit ────
if ! swapon --show=NAME --noheadings | grep -q '/swapfile'; then
  if [[ ! -f /swapfile ]]; then
    fallocate -l 2G /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
  fi
  swapon /swapfile
  echo "swap: enabled 2G /swapfile"
else
  echo "swap: already enabled"
fi
if ! grep -q '^/swapfile' /etc/fstab; then
  echo '/swapfile none swap sw 0 0' >>/etc/fstab
fi
if [[ ! -f /etc/sysctl.d/90-swappiness.conf ]]; then
  echo 'vm.swappiness=10' >/etc/sysctl.d/90-swappiness.conf
  sysctl -q -p /etc/sysctl.d/90-swappiness.conf
fi

# ── App user: uid 1000, matching the compose files' APP_UID default ─────────
# The repo checkout and the bind-mount writes (node_modules, dist) belong to
# this user; run git + compose on the box as `virtu`, never root.
if ! id virtu >/dev/null 2>&1; then
  adduser --disabled-password --gecos "virtu app" virtu
  echo "user: created virtu ($(id -u virtu):$(id -g virtu))"
else
  echo "user: virtu exists"
fi

# ── Base packages ────────────────────────────────────────────────────────────
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
# unzip is for the bun installer below.
apt-get install -y -qq ca-certificates curl git unzip unattended-upgrades >/dev/null
# Debian's unattended-upgrades defaults to security-only once this stamp
# file enables the periodic run.
cat >/etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

# ── Docker CE + compose plugin (official apt repo) ───────────────────────────
if ! command -v docker >/dev/null; then
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  # shellcheck source=/dev/null
  codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $codename stable" \
    >/etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin >/dev/null
  systemctl enable --now docker
  echo "docker: installed"
else
  echo "docker: already installed"
fi
usermod -aG docker virtu

# ── Bun + just: the break-glass CLI runs on the HOST ─────────────────────────
# bin/queue-* and bin/admin-* do `cd server && bun run src/scripts/…` directly
# rather than `compose exec api`, precisely so they still work when the stack
# is down — which is when you need them. That only holds if bun is on the box.
# Both land in /usr/local/bin (already on everyone's PATH) instead of the
# invoking user's ~/.bun, so `virtu` gets them without a login-shell dance.
#
# Deliberately NOT `curl https://…/install.sh | bash`: that runs whatever the
# vendor serves today as root, unverified. We pin a version AND its published
# SHA-256 and check it before anything executes — the same trust posture as the
# Docker block above pinning a signing key. Bumping a version means updating
# its checksum here; get them from the release's SHASUMS256.txt / SHA256SUMS.
arch=$(dpkg --print-architecture)

# Keep BUN_VERSION on the same line as the compose images (oven/bun:1.3).
BUN_VERSION="1.3.14"
if [[ "$(bun --version 2>/dev/null || true)" != "$BUN_VERSION" ]]; then
  case "$arch" in
    # x64 non-baseline needs AVX2; the vendor installer sniffs the same flag.
    amd64)
      if grep -qm1 '\bavx2\b' /proc/cpuinfo; then
        bun_target="bun-linux-x64"
        bun_sha="951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f"
      else
        bun_target="bun-linux-x64-baseline"
        bun_sha="a063908ae08b7852ca10939bbdc6ceed3ddabce8fb9402dce83d65d73b36e6c7"
      fi
      ;;
    arm64)
      bun_target="bun-linux-aarch64"
      bun_sha="a27ffb63a8310375836e0d6f668ae17fa8d8d18b88c37c821c65331973a19a3b"
      ;;
    *) echo "host-provision: no pinned bun checksum for arch '$arch'" >&2; exit 1 ;;
  esac
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/bun.zip" \
    "https://github.com/oven-sh/bun/releases/download/bun-v$BUN_VERSION/$bun_target.zip"
  echo "$bun_sha  $tmp/bun.zip" | sha256sum -c --quiet -
  unzip -qo "$tmp/bun.zip" -d "$tmp"
  install -m 0755 "$tmp/$bun_target/bun" /usr/local/bin/bun
  rm -rf "$tmp"
  echo "bun: installed $BUN_VERSION ($bun_target)"
else
  echo "bun: $BUN_VERSION already installed"
fi

# just is a convenience wrapper over bin/, never load-bearing (CLAUDE.md —
# "just is convenience, not authority"), but it gets the same treatment: an
# unverified root install is an unverified root install.
JUST_VERSION="1.58.0"
if [[ "$(just --version 2>/dev/null | awk '{print $2}')" != "$JUST_VERSION" ]]; then
  case "$arch" in
    amd64)
      just_target="x86_64-unknown-linux-musl"
      just_sha="4a5cc2f53e6f0f8c59092a6cc38291eb729d46a7dd95d3ae582008881b84931d"
      ;;
    arm64)
      just_target="aarch64-unknown-linux-musl"
      just_sha="748237128c4c40cbdabc65e841d05ceba13cc23a91eaba395495894c1d9764df"
      ;;
    *) echo "host-provision: no pinned just checksum for arch '$arch'" >&2; exit 1 ;;
  esac
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/just.tar.gz" \
    "https://github.com/casey/just/releases/download/$JUST_VERSION/just-$JUST_VERSION-$just_target.tar.gz"
  echo "$just_sha  $tmp/just.tar.gz" | sha256sum -c --quiet -
  tar -xzf "$tmp/just.tar.gz" -C "$tmp" just
  install -m 0755 "$tmp/just" /usr/local/bin/just
  rm -rf "$tmp"
  echo "just: installed $JUST_VERSION"
else
  echo "just: $JUST_VERSION already installed"
fi

echo
echo "host-provision: done"
swapon --show
docker --version
docker compose version
git --version
bun --version
just --version
