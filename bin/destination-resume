#!/usr/bin/env bash
#
# destination-resume — lift a recipient domain's outbound pause now
# (queue/destinationThrottle.ts). Mirrors DELETE /api/admin/destinations/:domain.
#
# Usage: bin/destination-resume <domain>

set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: bin/destination-resume <domain>" >&2
  exit 2
fi

cd "$(dirname "$0")/.."
exec bin/server-run bun run src/scripts/destinationResume.ts "$1"
