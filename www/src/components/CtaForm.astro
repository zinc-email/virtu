---
// Static (logged-out) port of the legacy auth-login-form
// (tmp/virtu/server/src/views/auth/auth-login-form.php).
//
// Like the legacy form, this is the single entrypoint for login AND signup:
// the app's passwordless flow makes them the same thing, so the form submits
// the email as a GET param to the SPA's login page (reverse-proxy mounted at
// /app), which requests the emailed code immediately — the visitor lands
// straight on the code-entry step.

interface Props {
  note?: string;
  autofocus?: boolean;
}

const { note = "Enter your e-mail address to login or signup.", autofocus = false } = Astro.props;
---

<form class="auth-login-form form" action="/app/login" method="GET">
  <div class="field">
    <input
      type="email"
      name="email"
      placeholder="yourname@gmail.com"
      autofocus={autofocus}
    />
    <div class="note">{note}</div>
  </div>
  <div class="field">
    <button class="submit" type="submit">Protect My Inbox</button>
  </div>
</form>
