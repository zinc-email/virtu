# virtu-ts server config. Copy to `server/.env` (gitignored) and edit.
# Bun auto-loads .env from the working directory; every entrypoint (api, mx,
# submission, deliverd) reads these via src/config.ts. Every var has a dev
# default — an empty .env runs locally. Values below are the defaults unless
# noted; the ones marked (PROD) MUST be overridden for production.

# ── Core ────────────────────────────────────────────────────────────────────
# (PROD) Set to "production" on a real deploy box. The app then REFUSES to boot
# on any known-insecure secret default (VERP_SECRET, DATABASE_URL) — fail closed
# rather than run with a secret every reader of this repo knows. Unset = dev.
# VIRTU_ENV=production
# On a deploy box this is the HOST-reachable URL, for the break-glass CLI
# (bin/queue-*, bin/admin-*) which runs bun on the host so it still works with
# the stack down. The serve stack publishes Postgres on 127.0.0.1:5433, and
# api/maild ignore this line — compose sets DATABASE_URL=…@db:5432 in their
# environment, which wins over a .env file. So: …@127.0.0.1:5433/virtu with the
# box's real POSTGRES_PASSWORD.
DATABASE_URL=postgres://virtu:virtu@localhost:5432/virtu
API_HOST=0.0.0.0
API_PORT=3000
# Requests/minute per IP across the auth routes (register/activate/login).
# The dev compose raises this to 1000 so the DOM test tier can register
# freely; keep the default in production.
AUTH_RATE_LIMIT_MAX=10
# Invite-only signup (ABUSE.md Tier 0): "true" makes /auth/verify refuse to
# create NEW accounts without a valid invite code (existing users log in
# unaffected). Mint codes with `just invite-create` or the admin UI. Off by
# default (dev/lmnop open); zinc sets true until the abuse detector is live.
SIGNUP_INVITE_ONLY=false

# ── Mail path (mx / submission / deliverd) ───────────────────────────────────
# Domain that aliases, reverse aliases, and VERP bounce addresses live on.
MAIL_DOMAIN=virtu.email
# Comma-separated domains offered for alias creation; first is the default.
# Empty (the default) => MAIL_DOMAIN. Set only to offer EXTRA domains.
# ALIAS_DOMAINS=
# (PROD) HMAC key for signed alias suffixes (SimpleLogin CUSTOM_ALIAS_SECRET
# analog). Unset in dev => derived from DATABASE_URL. REQUIRED when
# VIRTU_ENV=production (the app refuses to boot without it) — don't derive a
# signing key from the DB connection string in prod. `openssl rand -base64 32`.
# ALIAS_SIGNING_SECRET=
# Our MX hostname: SMTP banner, EHLO, Authentication-Results stamps.
MAIL_HOSTNAME=mail.virtu.email
# DKIM selector for our signing key in the dkim_keys table
# ({selector}._domainkey.{domain}).
DKIM_SELECTOR=mail
# (PROD) HMAC secret for VERP bounce addresses. >= 32 chars. The default is a
# known dev value — generate a real one: `openssl rand -base64 32`.
VERP_SECRET=insecure-dev-verp-secret-change-me-00
# (PROD) PEM cert + key for STARTTLS (25/587) and implicit TLS (465). Both
# unset => plaintext-only listeners (local dev), and AUTH-over-TLS is not
# required. Production needs a real cert for MAIL_HOSTNAME — in the serve
# stack that's Caddy's cert, synced into the mail_certs volume (README
# "Deploy" > "Mail TLS"), so a deploy box uses exactly these paths:
# SMTP_TLS_CERT_FILE=/mail-certs/fullchain.pem
# SMTP_TLS_KEY_FILE=/mail-certs/privkey.pem
SMTP_HOST=0.0.0.0
MX_PORT=25
SUBMISSION_PORT=587
SUBMISSION_TLS_PORT=465
# Max accepted message size, bytes (default 25 MiB).
SMTP_MAX_MESSAGE_SIZE=26214400
# Per-user outbound send quota, enforced at submission pre-enqueue:
# recipients per rolling 24h, by plan. 0 = unlimited. Overridable per account
# via users.max_daily_sends (0 there = unlimited too). Caps what a leaked
# device credential can blast through our IP; inbound forwards never count.
SEND_QUOTA_FREE_PER_DAY=50
SEND_QUOTA_PREMIUM_PER_DAY=500
# deliverd egress guard (SSRF). Default false: refuse to deliver to a recipient
# domain whose MX (or implicit-MX A record) resolves to a private/loopback/
# link-local address. Only the simulated-internet test stack sets this true
# (its peers are on 192.168.x) — leave it unset/false in production.
# SMTP_ALLOW_PRIVATE_TARGETS=false

# ── Observability ────────────────────────────────────────────────────────────
# Daemon log lines (mx/submission/deliverd/maild): "json" (deploy form, what
# Alloy ships to Grafana Cloud Loki) or "pretty" (humans; the test network
# sets this so `just test-net-logs` stays readable). The API's request logs
# are Fastify's pino either way.
LOG_FORMAT=json
# debug | info | warn | error
LOG_LEVEL=info
# maild's metrics + health listener (Prometheus text format at /metrics,
# liveness at /health). Loopback by default; the serve stack overrides
# METRICS_HOST=0.0.0.0 so the Alloy container can scrape maild:9100 over the
# compose network — the port is never published to the host. The API exposes
# its metrics on the existing HTTP port at /meta/metrics instead.
METRICS_HOST=127.0.0.1
METRICS_PORT=9100

# ── Delivery queue (deliverd) ────────────────────────────────────────────────
QUEUE_POLL_MS=1000
QUEUE_BATCH_SIZE=10
# Max delivery attempts before a transient failure becomes permanent, and the
# cap on any single retry delay. Defaults (25 tries, 6h cap) ≈ 4 days of
# retrying — RFC 5321's customary horizon. The test network pins fast values.
QUEUE_MAX_TRIES=25
QUEUE_BACKOFF_MAX_MS=21600000
# Queue hygiene, run inside the worker loop. A `sending` row claimed longer
# ago than QUEUE_STUCK_SENDING_MINUTES is presumed orphaned by a crashed
# worker and reaped back to `pending` (at-least-once delivery). Terminal rows
# age out: sent after QUEUE_RETAIN_SENT_DAYS (their raw bytes are cleared on
# the terminal write), failed after QUEUE_RETAIN_FAILED_DAYS (raw kept so
# `bin/queue-requeue` / the admin Requeue button still work).
QUEUE_STUCK_SENDING_MINUTES=15
QUEUE_REAP_INTERVAL_MS=60000
QUEUE_RETENTION_INTERVAL_MS=3600000
QUEUE_RETAIN_SENT_DAYS=7
QUEUE_RETAIN_FAILED_DAYS=30
# smtp_rejections rows (SMTP-time refusals, abuse forensics) age out on the
# same retention tick. 0 keeps them forever.
SMTP_REJECTIONS_RETAIN_DAYS=30

# ── Billing (Stripe — optional) ──────────────────────────────────────────────
# All four unset => billing routes answer 503, rest of the app is unaffected.
# Use test-mode keys for local dev. See README "Billing".
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen`
# STRIPE_PRICE_ID=price_...                # a recurring price
# BILLING_RETURN_URL=http://localhost:9000 # browser return origin
