<?xml version="1.0" encoding="utf-8"?>
<!-- The share-target mini-dialog: subtitle, the alias (selectable), and a
     button row. Views start hidden and appear as the flow resolves. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/share_title"
      android:textAppearance="?android:attr/textAppearanceLarge" />

  <TextView
      android:id="@+id/subtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textAppearance="?android:attr/textAppearanceSmall" />

  <TextView
      android:id="@+id/alias"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:textAppearance="?android:attr/textAppearanceMedium"
      android:textIsSelectable="true"
      android:textStyle="bold"
      android:visibility="gone" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:gravity="end"
      android:orientation="horizontal">

    <Button
        android:id="@+id/openApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/share_open_app"
        android:visibility="gone" />

    <Button
        android:id="@+id/copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/share_copy"
        android:visibility="gone" />

    <Button
        android:id="@+id/done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/share_done" />
  </LinearLayout>
</LinearLayout>
