#!/usr/bin/env bash
#
# login-code — print the newest emailed verification code for an address.
#
# Verification emails (account activation, mailbox verification) are enqueued
# in outbound_messages; the dev stack runs no deliverd, so the freshest code
# for an address is sitting in the queue. Reads the dev database directly
# (DATABASE_URL, default localhost:5432).
#
# Usage: bin/login-code <email>

set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: bin/login-code <email>" >&2
  exit 2
fi

cd "$(dirname "$0")/../server"

exec bun -e '
import { db } from "./src/db";
import { outboundMessages } from "./src/db/schema";
import { desc, eq } from "drizzle-orm";

const email = process.argv[1].trim().toLowerCase();
const rows = await db
  .select()
  .from(outboundMessages)
  .where(eq(outboundMessages.envelopeTo, email))
  .orderBy(desc(outboundMessages.id))
  .limit(1);
if (rows.length === 0) {
  console.error(`no queued mail for ${email}`);
  process.exit(1);
}
const body = new TextDecoder().decode(rows[0].raw);
const match = body.match(/\b(\d{6})\b/);
if (!match) {
  console.error(`newest message for ${email} contains no 6-digit code`);
  process.exit(1);
}
console.log(match[1]);
process.exit(0);
' "$1"
