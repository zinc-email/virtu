<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- First group = default group for new Keychain items (KeychainStore).
       Shared with the Track D/G extensions when they land. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)email.zinc.virtu.shared</string>
  </array>
</dict>
</plist>
