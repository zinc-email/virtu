#!/usr/bin/env bash
# host-db-push — apply server/src/db/schema.ts to the live DB (push-based
# migrations; PLAN: no migration files). Deliberately manual + interactive:
# no --force, so drizzle-kit prints and confirms any data-loss statements
# before running them. The unattended deploy lane (bin/host-deploy, and the
# v* tag workflow on top of it) never touches the schema.
#
# Run on the box, from the repo root, as the app user, with a TTY:
#   bin/host-db-push
# From a workstation: ssh -t root@<box> 'runuser -u virtu -- bash -lc "cd /opt/virtu && bin/host-db-push"'
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ ! -t 0 ]]; then
  echo "host-db-push: needs a TTY (drizzle-kit's data-loss review is interactive) — use ssh -t" >&2
  exit 1
fi

bin/compose -f docker-compose.serve.yml exec api bun drizzle-kit push
