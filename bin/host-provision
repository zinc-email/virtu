#!/usr/bin/env bash
# host-provision — one-time (idempotent) setup of a fresh Debian box for the
# serve stack: swap (the nanodes have 1GB RAM and the frontend build needs
# more), Docker CE + compose plugin, git, bun + just (the break-glass CLI runs
# on the host, not in a container), unattended security upgrades.
#
# Run from a workstation:   ssh root@<box> 'bash -s' < bin/host-provision
# Or on the box itself:     bash bin/host-provision
#
# Per-box things this does NOT do (see README "Deploy"): rDNS, DNS records,
# cloning the repo, writing server/.env, starting the stack.
set -euo pipefail

if [[ $(id -u) -ne 0 ]]; then
  echo "host-provision: must run as root" >&2
  exit 1
fi

# ── Swap: 2G file, so docker + postgres + the one-shot frontend build fit ────
if ! swapon --show=NAME --noheadings | grep -q '/swapfile'; then
  if [[ ! -f /swapfile ]]; then
    fallocate -l 2G /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
  fi
  swapon /swapfile
  echo "swap: enabled 2G /swapfile"
else
  echo "swap: already enabled"
fi
if ! grep -q '^/swapfile' /etc/fstab; then
  echo '/swapfile none swap sw 0 0' >>/etc/fstab
fi
if [[ ! -f /etc/sysctl.d/90-swappiness.conf ]]; then
  echo 'vm.swappiness=10' >/etc/sysctl.d/90-swappiness.conf
  sysctl -q -p /etc/sysctl.d/90-swappiness.conf
fi

# ── App user: uid 1000, matching the compose files' APP_UID default ─────────
# The repo checkout and the bind-mount writes (node_modules, dist) belong to
# this user; run git + compose on the box as `virtu`, never root.
if ! id virtu >/dev/null 2>&1; then
  adduser --disabled-password --gecos "virtu app" virtu
  echo "user: created virtu ($(id -u virtu):$(id -g virtu))"
else
  echo "user: virtu exists"
fi

# ── Base packages ────────────────────────────────────────────────────────────
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
# unzip is for the bun installer below.
apt-get install -y -qq ca-certificates curl git unzip unattended-upgrades >/dev/null
# Debian's unattended-upgrades defaults to security-only once this stamp
# file enables the periodic run.
cat >/etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

# ── Docker CE + compose plugin (official apt repo) ───────────────────────────
if ! command -v docker >/dev/null; then
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  # shellcheck source=/dev/null
  codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $codename stable" \
    >/etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin >/dev/null
  systemctl enable --now docker
  echo "docker: installed"
else
  echo "docker: already installed"
fi
usermod -aG docker virtu

# ── Bun + just: the break-glass CLI runs on the HOST ─────────────────────────
# bin/queue-* and bin/admin-* do `cd server && bun run src/scripts/…` directly
# rather than `compose exec api`, precisely so they still work when the stack
# is down — which is when you need them. That only holds if bun is on the box.
# Both install into /usr/local/bin (already on everyone's PATH) instead of the
# invoking user's ~/.bun, so `virtu` gets them without a login-shell dance.

# Pinned to the same line as the compose images (oven/bun:1.3) — keep the two
# in step, and re-run this script to apply a bump.
BUN_VERSION="${BUN_VERSION:-1.3.14}"
if [[ "$(bun --version 2>/dev/null || true)" != "$BUN_VERSION" ]]; then
  curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash -s "bun-v$BUN_VERSION" >/dev/null
  echo "bun: installed $BUN_VERSION"
else
  echo "bun: $BUN_VERSION already installed"
fi

# Unpinned: just is a convenience wrapper over bin/, never load-bearing (see
# CLAUDE.md — "just is convenience, not authority"), so latest is fine.
if ! command -v just >/dev/null; then
  curl -fsSL https://just.systems/install.sh | bash -s -- --to /usr/local/bin >/dev/null
  echo "just: installed"
else
  echo "just: already installed"
fi

echo
echo "host-provision: done"
swapon --show
docker --version
docker compose version
git --version
bun --version
just --version
